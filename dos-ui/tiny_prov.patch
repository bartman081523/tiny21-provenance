# Provenance patch for TINY.C
#
# Apply:   patch -p0 < tiny_prov.patch      (or use TINY_PROV.C directly)
#
# The patch does three things:
#   1. renames the __TURBOC__ guard to TINY_DOS_UI (3 sites), so the DOS UI
#      builds with OpenWatcom without touching the compiler's own macros,
#   2. adds the provenance readout: a 4-layer ensemble of the familiarity
#      axis, combined with the answer confidence (p_top of the first answer
#      token), plus a domain gate (only "capital" questions get a verdict),
#   3. includes tc_compat.c into the same translation unit.
#
# Three files are NOT in this diff and must sit next to TINY_PROV.C:
#   PROV.H        generated by dos-ui/export_prov.py
#   tc_compat.h   Turbo C text-mode API for OpenWatcom
#   tc_compat.c   implementation (included by TINY_PROV.C)
#
# Build:  wcl -ml -bt=dos -l=dos -wcd=481 -DTINY_DOS_UI -fe=TINY_PROV.EXE TINY_PROV.C
--- TINY.C	2026-11-18 00:44:09.865031744 +0100
+++ TINY_PROV.C	2026-11-18 04:06:12.659639769 +0100
@@ -145,6 +145,43 @@
 
 /* Work buffers (static, so they do not use the small DOS stack). */
 static float bx[MAXD], bh[MAXD], bq[MAXD], bt[MAXD], ba[MAXD], bm[MAXHID], bs[CTX];
+
+/* ---- provenance -----------------------------------------------------
+   A linear readout on the layer-0 state of the last question letter.
+   The direction was fitted on THIS weight file (TINY.BIN, quantised),
+   it is not a property of the float checkpoint. Generated by
+   dos-ui/export_prov.py; PROV.H must sit next to this file. */
+#include "PROV.H"
+/* the axis is a multi-layer ensemble: each layer's projection is
+   standardised by the familiar group and averaged. Single layer 0 gives
+   0.775 leave-one-out accuracy, the 4-layer ensemble 0.950. */
+static float prov_h[PROV_L][MAXD];
+static float prov_score;
+static float prov_conf;      /* p_top of the first answer token */
+static int prov_valid;
+
+static void prov_finish(int n, const char *q)
+{
+    int i, l;
+    float s;
+    /* Domain gate: the axis was fitted on "capital of X" questions. A
+       spelling or arithmetic prompt sits near the familiar centroid and
+       would be called "familiar", which says nothing about the answer.
+       Outside the calibrated phrasing the panel shows "--". */
+    if (n <= 0 || D != PROV_D || strstr(q, "capital") == NULL) {
+        prov_valid = 0;
+        return;
+    }
+    prov_score = 0.0f;
+    for (l = 0; l < PROV_L; l++) {
+        s = 0.0f;
+        for (i = 0; i < D; i++)
+            s += prov_h[l][i] * PROV_DIR[l][i];
+        prov_score += (s - PROV_MEAN[l]) / PROV_STD[l];
+    }
+    prov_score = prov_score / (float)PROV_L - PROV_THR_Z;
+    prov_valid = 1;
+}
 static float layer_act[MAXL];               /* how busy each layer was */
 
 static void alloc_memory(void)
@@ -276,6 +313,10 @@
         matvec(&f2[l], bm, bt);
         for (i = 0; i < D; i++)
             bx[i] += bt[i];
+        if (l < PROV_L) {           /* ensemble reads layers 0..PROV_L-1 */
+            for (i = 0; i < D; i++)
+                prov_h[l][i] = bx[i];
+        }
     }
     norm(bx, gf, bh);
     matvec(&emb, bh, score);
@@ -342,7 +383,12 @@
         if (on_step) on_step(p, n);
         step(q[p] - 30, p, score);
     }
+    prov_finish(n, q);          /* fam axis: last QUESTION letter state */
     step(1, p++, score);                       /* end of the question */
+    prov_conf = 0.0f;           /* p_top of the first answer token */
+    for (tok = 0; tok < VOCAB; tok++)
+        if (score[tok] > prov_conf)
+            prov_conf = score[tok];
     for (; p < CTX; p++) {
         tok = pick();
         if (tok <= 1) break;                   /* end of the answer */
@@ -423,7 +469,7 @@
     return 0;
 }
 
-#ifdef __TURBOC__
+#ifdef TINY_DOS_UI

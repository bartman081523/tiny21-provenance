# Provenance patch for TINY.C
#
# Apply:   patch -p0 < tiny_prov.patch      (or use TINY_PROV.C directly)
#
# The patch does three things:
#   1. renames the __TURBOC__ guard to TINY_DOS_UI (3 sites), so the DOS UI
#      builds with OpenWatcom without touching the compiler's own macros,
#   2. adds the provenance readout (layer-0 state, generated PROV.H),
#   3. includes tc_compat.c into the same translation unit.
#
# Three files are NOT in this diff and must sit next to TINY_PROV.C:
#   PROV.H        generated by dos-ui/export_prov.py
#   tc_compat.h   Turbo C text-mode API for OpenWatcom
#   tc_compat.c   implementation (included by TINY_PROV.C)
#
# Build:  wcl -ml -bt=dos -l=dos -wcd=481 -DTINY_DOS_UI -fe=TINY_PROV.EXE TINY_PROV.C
--- TINY.C	2026-11-18 00:44:09.865031744 +0100
+++ TINY_PROV.C	2026-11-18 03:13:29.943946140 +0100
@@ -145,6 +145,29 @@
 
 /* Work buffers (static, so they do not use the small DOS stack). */
 static float bx[MAXD], bh[MAXD], bq[MAXD], bt[MAXD], ba[MAXD], bm[MAXHID], bs[CTX];
+
+/* ---- provenance -----------------------------------------------------
+   A linear readout on the layer-0 state of the last question letter.
+   The direction was fitted on THIS weight file (TINY.BIN, quantised),
+   it is not a property of the float checkpoint. Generated by
+   dos-ui/export_prov.py; PROV.H must sit next to this file. */
+#include "PROV.H"
+static float prov_h[MAXD];
+static float prov_score;
+static int prov_valid;
+
+static void prov_finish(int n)
+{
+    int i;
+    if (n <= 0 || D != PROV_D) { /* empty question / other weights */
+        prov_valid = 0;
+        return;
+    }
+    prov_score = -PROV_THR;
+    for (i = 0; i < D; i++)
+        prov_score += prov_h[i] * PROV_DIR[i];
+    prov_valid = 1;
+}
 static float layer_act[MAXL];               /* how busy each layer was */
 
 static void alloc_memory(void)
@@ -276,6 +299,10 @@
         matvec(&f2[l], bm, bt);
         for (i = 0; i < D; i++)
             bx[i] += bt[i];
+        if (l == 0) {               /* provenance reads the layer-0 state */
+            for (i = 0; i < D; i++)
+                prov_h[i] = bx[i];
+        }
     }
     norm(bx, gf, bh);
     matvec(&emb, bh, score);
@@ -342,6 +369,7 @@
         if (on_step) on_step(p, n);
         step(q[p] - 30, p, score);
     }
+    prov_finish(n);                            /* before the newline */
     step(1, p++, score);                       /* end of the question */
     for (; p < CTX; p++) {
         tok = pick();
@@ -423,7 +451,7 @@
     return 0;
 }
 
-#ifdef __TURBOC__
+#ifdef TINY_DOS_UI
 /* ==================================================================
    The DOS screen: Turbo C conio for text, the PC speaker for sound,
    and on VGA a reprogrammed neon colour palette.
@@ -431,6 +459,8 @@
 #include <conio.h>
 #include <dos.h>
 #include <io.h>
+#include "tc_compat.h"
+#include "tc_compat.c"      /* same translation unit: one code model */
 
 #define SCRW   80
 #define CHAT_L 3                /* chat window, inside its frame */
@@ -737,6 +767,7 @@
         put_at(MON_X, 4 + l, C_FRAME, buf);
         meter(MON_X + 3, 4 + l, 15, 0, C_ANSWER);
     }
+    put_at(MON_X, 8, C_DIM, "PROVENANCE");
     put_at(MON_X, 10, C_DIM, "CONFIDENCE");
     meter(MON_X, 11, 13, 0, C_ANSWER);
     put_at(MON_X, 12, C_DIM, "LAST LETTERS");
@@ -759,6 +790,21 @@
         meter(MON_X + 3, 4 + l, 15, v, l % 2 ? C_FRAME : C_ANSWER);
         act_max[l] *= 0.995f;
     }
+    if (!prov_valid || (prov_score > -PROV_MARGIN && prov_score < PROV_MARGIN)) {
+        put_at(MON_X, 9, C_DIM, "   --     ");
+        if (prov_valid) {
+            sprintf(buf, "%+6.1f", prov_score);
+            put_at(MON_X + 10, 9, C_DIM, buf);
+        }
+    } else if (prov_score > 0.0f) {
+        put_at(MON_X, 9, C_ANSWER, "familiar ");
+        sprintf(buf, "%+6.1f", prov_score);
+        put_at(MON_X + 10, 9, C_DIM, buf);
+    } else {
+        put_at(MON_X, 9, C_HOT, "UNBACKED ");
+        sprintf(buf, "%+6.1f", prov_score);
+        put_at(MON_X + 10, 9, C_DIM, buf);
+    }
     v = (int)(last_conf * 1000.0f);
     meter(MON_X, 11, 13, v, v > 800 ? C_ANSWER : v > 500 ? C_QTEXT : C_HOT);
     sprintf(buf, " %3d%%", v / 10);
@@ -1372,7 +1418,7 @@
             creativity = argv[i][0] - '0';
         else if (is_word(argv[i], "/p") || is_word(argv[i], "-p"))
             plain = 1;
-#ifdef __TURBOC__
+#ifdef TINY_DOS_UI
         else if (is_word(argv[i], "/demo") || is_word(argv[i], "-demo"))
             demo = 1;
         else if (is_word(argv[i], "/dump"))
@@ -1388,7 +1434,7 @@
 #endif
